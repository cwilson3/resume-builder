/**
 * Turns perf/results/raw/*.json (written by perf.spec.ts) into Markdown tables in
 * perf/results/tables.md. Run from this package: node perf/report.mts
 *
 * Latencies: the median of the per-run medians, then the worst of the per-run 95th percentiles
 * (perf/README.md says why). Per-run totals (script time, long tasks): the median run, with the range.
 * The page-size column is measured from the builds on disk now, so build all three before reporting.
 */
import { existsSync, mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { gzipSync } from 'node:zlib';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
const rawDir = path.join(here, 'results/raw');
const ROOT = path.resolve(here, '../..');
const SHELL_ORDER = ['vanilla', 'react-initial', 'react-optimized'];
const SHELL_FILES: Record<string, string> = {
  vanilla: path.join(ROOT, 'dist/index.html'),
  'react-initial': path.join(here, 'builds/react-initial.html'),
  'react-optimized': path.join(ROOT, 'resume-builder-react/dist/index.html'),
};

interface Cdp { scriptMs: number; layoutMs: number; styleMs: number; heapMb: number }
interface Typing { keydown: number[]; longtasks: number[]; cdp: Cdp }
interface Run {
  keyEditor: number[]; keyPreview: number[]; keyRaw: number[];
  typing: { debounced: Typing; raw: Typing };
  structural: Record<'addEntry' | 'deleteEntry' | 'moveBlock' | 'moveSection' | 'undo', number[]>;
  structuralCdp: Cdp;
}
interface Result {
  shell: string; label: string; fixture: string; date: string; chromium: string; machine: string; cpuThrottle: number;
  settings: { runs: number; iterations: number; cold: number; typed: number; typeDelayMs: number };
  runs: Run[]; cold: { firstRenderMs: number; fcpMs: number; cdp: Cdp }[];
  /** Absent in files written before the harness recorded stuck loads; none occurred in those. */
  coldTimeouts?: { blocks: number; readyState: string; observers: boolean }[];
}

const quantile = (xs: number[], q: number): number => {
  const s = [...xs].sort((a, b) => a - b);
  return s[Math.min(s.length - 1, Math.floor(q * s.length))] ?? Number.NaN;
};
const median = (xs: number[]) => quantile(xs, 0.5);
const f1 = (x: number) => x.toFixed(1);
const f0 = (x: number) => Math.round(x).toString();

/** "median / worst p95" across runs. */
const latency = (perRun: number[][]) => `${f1(median(perRun.map((r) => median(r))))} / ${f1(Math.max(...perRun.map((r) => quantile(r, 0.95))))}`;
/** "median (min–max)" of one number per run. */
const spread = (values: number[], fmt = f0) => `${fmt(median(values))} (${fmt(Math.min(...values))}–${fmt(Math.max(...values))})`;

const results: Result[] = readdirSync(rawDir)
  .filter((f) => f.endsWith('.json'))
  .map((f) => JSON.parse(readFileSync(path.join(rawDir, f), 'utf8')) as Result);
const fixtures = [...new Set(results.map((r) => r.fixture))].sort();

const out: string[] = ['<!-- Generated by perf/report.mts from perf/results/raw. Do not edit by hand. -->', ''];
for (const fixture of fixtures) {
  const rows = SHELL_ORDER.map((id) => results.find((r) => r.fixture === fixture && r.shell === id)).filter((r): r is Result => r !== undefined);
  const first = rows[0];
  out.push(`### \`${fixture}.md\``, '');
  out.push(
    `${first.chromium} · ${first.machine} · CPU throttled ${first.cpuThrottle}x · ${first.settings.runs} runs × ${first.settings.iterations} iterations · ` +
      `measured ${[...new Set(rows.map((r) => r.date.slice(0, 10)))].join(', ')}`,
    '',
  );

  out.push('**Typing, one key at a time** (ms, median / worst p95)', '');
  out.push('| Shell | Keystroke to preview paint, 120 ms debounce | Keystroke to preview paint, `?debounce=0` | Keystroke to editor paint, 120 ms debounce |');
  out.push('| ----- | ---: | ---: | ---: |');
  for (const r of rows) out.push(`| ${r.label} | ${latency(r.runs.map((x) => x.keyPreview))} | ${latency(r.runs.map((x) => x.keyRaw))} | ${latency(r.runs.map((x) => x.keyEditor))} |`);
  out.push('');

  const s = first.settings;
  out.push(`**Sustained typing**, ${s.typed} characters at one per ${s.typeDelayMs} ms (per run: median run, range)`, '');
  out.push('| Shell | Script ms, debounced | Long tasks, debounced | Script ms, `?debounce=0` | Layout ms, `?debounce=0` | Long tasks, `?debounce=0` | Long-task ms, `?debounce=0` |');
  out.push('| ----- | ---: | ---: | ---: | ---: | ---: | ---: |');
  for (const r of rows) {
    const d = r.runs.map((x) => x.typing.debounced);
    const w = r.runs.map((x) => x.typing.raw);
    const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
    out.push(
      `| ${r.label} | ${spread(d.map((t) => t.cdp.scriptMs))} | ${spread(d.map((t) => t.longtasks.length))} | ${spread(w.map((t) => t.cdp.scriptMs))} | ` +
        `${spread(w.map((t) => t.cdp.layoutMs))} | ${spread(w.map((t) => t.longtasks.length))} | ${spread(w.map((t) => sum(t.longtasks)))} |`,
    );
  }
  out.push('');

  out.push('**Structural edits, `?debounce=0`**, click to next paint (ms, median / worst p95)', '');
  out.push('| Shell | + Entry | Delete entry | Move block | Move section | Undo | Script ms, all structural |');
  out.push('| ----- | ---: | ---: | ---: | ---: | ---: | ---: |');
  for (const r of rows) {
    const k = (key: keyof Run['structural']) => latency(r.runs.map((x) => x.structural[key]));
    out.push(`| ${r.label} | ${k('addEntry')} | ${k('deleteEntry')} | ${k('moveBlock')} | ${k('moveSection')} | ${k('undo')} | ${spread(r.runs.map((x) => x.structuralCdp.scriptMs))} |`);
  }
  out.push('');

  out.push(`**Cold open** with the fixture restored as the working copy (${first.settings.runs * first.settings.cold} loads; median / p95)`, '');
  out.push('| Shell | Editor rendered (ms) | First contentful paint (ms) | Script (ms) | JS heap (MB) | Page size, gzip -9 (KB) | Stuck loads replaced |');
  out.push('| ----- | ---: | ---: | ---: | ---: | ---: | ---: |');
  for (const r of rows) {
    const c = (pick: (x: Result['cold'][number]) => number) => `${f0(median(r.cold.map(pick)))} / ${f0(quantile(r.cold.map(pick), 0.95))}`;
    const file = SHELL_FILES[r.shell];
    const kb = existsSync(file) && statSync(file).isFile() ? (gzipSync(readFileSync(file), { level: 9 }).length / 1024).toFixed(1) : '?';
    out.push(`| ${r.label} | ${c((x) => x.firstRenderMs)} | ${c((x) => x.fcpMs)} | ${c((x) => x.cdp.scriptMs)} | ${f1(median(r.cold.map((x) => x.cdp.heapMb)))} | ${kb} | ${r.coldTimeouts?.length ?? 0} |`);
  }
  out.push('');
}

mkdirSync(path.join(here, 'results'), { recursive: true });
writeFileSync(path.join(here, 'results/tables.md'), out.join('\n'));
console.log(out.join('\n'));
