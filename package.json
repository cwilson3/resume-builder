{
  "name": "resume-builder",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "description": "Resume builder: edit a working copy of a master Markdown resume in the browser and download it as an ATS-friendly .md or .pdf. Never writes to the master.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:file": "tsx scripts/build-file.ts"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "pdfjs-dist": "^6.3.289",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
